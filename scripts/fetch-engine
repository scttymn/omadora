#!/usr/bin/env bash
# Find the engine for the widget to start: a development build in the
# plugin's bin/ (from `make engine`), else the release this checkout pins in
# engine-release.json, downloaded from GitHub into
# ~/.local/share/omadora/engine/ if it is missing or older. The download must
# match the pinned SHA-256, so the repository vouches for the exact file.
#
# Nothing is written inside the plugin's folder: Omarchy reloads a plugin
# when its files change, which would restart this script mid-download.
#
# An engine already running from anywhere else (the release before
# `omarchy plugin update`, a replaced file) is stopped, so the widget starts
# this one.
#
# Prints one line for the widget: "ok PATH", "updated PATH" (a running engine
# was stopped for this one), "warning PATH<tab>…" (kept the engine it had), or
# "error: …" (there is none). Exits non-zero only on an error.

set -euo pipefail
# Whatever else goes wrong, say so on the line the widget reads.
trap 'echo "error: setting up the Omadora engine failed (line $LINENO)"' ERR

here=$(cd "$(dirname "$0")/.." && pwd)
dev="$here/bin/omadora-engine"
pin="$here/engine-release.json"
dir="${XDG_DATA_HOME:-$HOME/.local/share}/omadora/engine"
bin="$dir/omadora-engine"
mark="$dir/omadora-engine.release"
repo="scttymn/omadora"

# Stop engines that aren't the one at $1; say so with "updated".
use() {
  local engine stopped=0 pid exe
  engine=$(realpath "$1")
  for pid in $(pgrep -u "$(id -u)" -x omadora-engine); do
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
    if [[ $exe != "$engine" ]]; then
      kill "$pid" 2>/dev/null && stopped=1
    fi
  done
  if ((stopped)); then echo "updated $engine"; else echo "ok $engine"; fi
  exit 0
}

# A development build (`make install` copies the plugin without .git). In a
# clone from GitHub, bin/ is never trusted: only a download the pin vouches
# for runs.
[[ -x $dev && ! -e $here/.git ]] && use "$dev"

have_engine() { [[ -x $bin ]]; }

# Keep a working engine when a new one cannot be had; fail only without one.
give_up() {
  if have_engine; then
    printf 'warning %s\t%s\n' "$(realpath "$bin")" "$1"
    exit 0
  fi
  echo "error: $1"
  exit 1
}

[[ -f $pin ]] || give_up "This copy of Omadora pins no engine release. Build one with: make engine"

version=$(jq -r '.version // empty' "$pin")
arch=$(uname -m)
sum=$(jq -r --arg arch "$arch" '.sha256[$arch] // empty' "$pin")
[[ -n $version && -n $sum ]] || give_up "No Omadora engine is released for $arch. Build one with: make engine"

wanted="$version $sum"
mkdir -p "$dir"
# One run at a time: a plugin reload can start several at once.
exec 9>"$dir/.lock"
flock 9
# Holding the lock, any partial download is from a run that was cut off.
rm -f "$dir"/.omadora-engine.*
if have_engine && [[ $(cat "$mark" 2>/dev/null) == "$wanted" ]]; then
  use "$bin"
fi

tmp=$(mktemp "$dir/.omadora-engine.XXXXXX")
trap 'rm -f "$tmp"' EXIT
trap 'exit 1' INT TERM HUP

url="https://github.com/$repo/releases/download/v$version/omadora-engine-$arch-linux"
curl -fsSL --proto '=https' --proto-redir '=https' --retry 2 --connect-timeout 15 --max-time 300 \
  -o "$tmp" "$url" ||
  give_up "Couldn't download the Omadora engine $version from GitHub."

got=$(sha256sum "$tmp" | cut -d' ' -f1)
[[ $got == "$sum" ]] || give_up "The downloaded Omadora engine did not match its checksum, so it was not used."

chmod 755 "$tmp"
mv -f "$tmp" "$bin"
printf '%s\n' "$wanted" >"$mark"
use "$bin"
