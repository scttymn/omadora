#!/usr/bin/env bash
# Record a published engine release in engine-release.json: its version and
# each binary's SHA-256. The binaries are downloaded and hashed here; the
# release's own .sha256 files must agree, and both architectures must be
# there. Pin right after the release workflow finishes.
#   scripts/pin-engine 0.3.3

set -euo pipefail

version=${1:?usage: scripts/pin-engine VERSION}
here=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

gh release download "v$version" --repo scttymn/omadora --pattern 'omadora-engine-*' --dir "$work"

sums="{}"
for arch in x86_64 aarch64; do
  name="omadora-engine-$arch-linux"
  [[ -f $work/$name && -f $work/$name.sha256 ]] || { echo "v$version has no $name and checksum" >&2; exit 1; }
  ours=$(sha256sum "$work/$name" | cut -d' ' -f1)
  theirs=$(cut -d' ' -f1 "$work/$name.sha256")
  [[ $ours =~ ^[0-9a-f]{64}$ ]] || { echo "bad hash for $name" >&2; exit 1; }
  [[ $ours == "$theirs" ]] || { echo "$name doesn't match its .sha256 on the release" >&2; exit 1; }
  sums=$(jq --arg arch "$arch" --arg sum "$ours" '. + {($arch): $sum}' <<<"$sums")
done

jq -n --arg version "$version" --argjson sha256 "$sums" '{version: $version, sha256: $sha256}' >"$here/engine-release.json"
cat "$here/engine-release.json"
